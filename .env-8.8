## Camunda 8.8 test stacks ##
# The integration tests run on Camunda 8.8 as well as 8.7 until the two are proven equivalent, then 8.7 is dropped
# (#123). This file holds the 8.8 stacks' settings, as .env holds the 8.7 ones, and is used with
# 'docker compose --env-file .env-8.8'. The versions follow Camunda's 8.8 compose files (camunda-distributions,
# docker-compose/versions/camunda-8.8).

## Image registry names ##
CAMUNDA_REGISTRY=ghcr.io/bp3
MAILPIT_REGISTRY=ghcr.io/bp3
ELASTIC_REGISTRY=ghcr.io/bp3
POSTGRES_REGISTRY=ghcr.io/bp3

## Image versions ##
# Orchestration cluster: Zeebe, Operate, Tasklist and Identity in one image
# renovate: datasource=docker depName=camunda/camunda
CAMUNDA_VERSION=8.8.48
# Management Identity, for Web Modeler
# renovate: datasource=docker depName=camunda/identity
CAMUNDA_IDENTITY_VERSION=8.8.24
# renovate: datasource=docker depName=camunda/web-modeler-restapi
CAMUNDA_WEB_MODELER_VERSION=8.8.28
# renovate: datasource=docker depName=elasticsearch
ELASTIC_VERSION=8.17.10
# Camunda's Keycloak image, not Bitnami's as on 8.7. Mirrored as camunda-keycloak, since keycloak is Bitnami's
KEYCLOAK_SERVER_VERSION=quay-26.6.4
# renovate: datasource=docker depName=axllent/mailpit
MAILPIT_VERSION=v1.21.8
POSTGRES_VERSION=15-alpine3.24
